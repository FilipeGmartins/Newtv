---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
    data: CollectionEntry<"channels">;
}

const { data } = Astro.props;
const { slug, displayName, description, imageUrl } = data.data;
---

<a href={`/channels/${slug}`}>
    <div
        class="card bg-base-100 transition-shadow shadow-sm group hover:shadow-lg"
    >
        {
            imageUrl && (
                <div>
                    <Image
                        src={imageUrl}
                        alt={`channel-${slug}-image`}
                        width={300}
                        height={100}
                        class="w-full h-52 object-cover rounded-t-lg"
                    />
                </div>
            )
        }
        <div class="card-body">
            <h2 class="card-title">{displayName}</h2>
            <p class="text-sm text-">{description}</p>
            <div class="card-actions justify-end">
                <button class="btn btn-link">Assistir</button>
            </div>
        </div>
    </div>
</a>
