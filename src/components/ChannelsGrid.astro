---
import GridItem from "./GridItem.astro";
import ChannelEPG from "./ChannelEPG.astro";
import type { Channel } from "@/services/rei";
interface Props { channels: Channel[] }
const { channels } = Astro.props;
---
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
  {channels.map(channel => <div>
    <GridItem title={channel.name} description={channel.description} imageSrc={channel.logo_url} playersCount={channel.embeds?.length ?? 0} href={`/channels/${encodeURIComponent(channel.id)}`} />
    <div class="p-3"><ChannelEPG epg={channel.epg} /></div>
  </div>)}
</div>
{channels.length === 0 && <p>Nenhum canal encontrado.</p>}
