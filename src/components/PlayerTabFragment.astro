---
import type { RawEmbed } from "@/models/embeds";
interface Props { embed: RawEmbed; index: number }
const { embed, index } = Astro.props;
const title = `Player ${index + 1} - ${embed.source}`;
---
<Fragment>
  <input type="radio" name="channel-tab" class="tab" aria-label={title} checked={index === 0} />
  <div class="tab-content bg-base-100 border-base-300">
    <iframe src={embed.url} title={title} class="w-full h-[70vh]" allow="autoplay; fullscreen; encrypted-media" allowfullscreen loading="lazy" referrerpolicy="no-referrer" sandbox="allow-same-origin allow-scripts allow-forms" style="border: none;"></iframe>
  </div>
</Fragment>
