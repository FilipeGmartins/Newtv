---
import type { RawEmbed } from "@/models/embeds";
import PageLayout from "./PageLayout.astro";
import PlayerTabFragment from "@components/PlayerTabFragment.astro";
interface Props { embeds: RawEmbed[] }
const { embeds } = Astro.props;
---
<PageLayout removePadding>
  <slot />
  {embeds.length ? <div class="tabs tabs-box min-h-[70vh]">
    {embeds.map((embed, index) => <PlayerTabFragment embed={embed} index={index} />)}
  </div> : <p class="p-4">Nenhum player disponível para esta transmissão.</p>}
</PageLayout>
