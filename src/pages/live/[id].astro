---
import PlayersLayout from "@layouts/PlayersLayout.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { getSport, playableEmbeds } from "@/services/rei";
import type { SportGame } from "@/models/events";
export const prerender = false;
let event: SportGame | undefined;
let failed = false;
try { event = await getSport(Astro.params.id ?? ""); } catch { failed = true; }
if (failed) Astro.response.status = 503;
else if (!event) Astro.response.status = 404;
---
{event ? <PlayersLayout embeds={playableEmbeds(event.embeds)}><h1 class="p-4 text-2xl font-bold">{event.title}</h1></PlayersLayout> : <PageLayout><p role="alert">{failed ? "Não foi possível carregar o evento. Tente novamente em instantes." : "Evento não encontrado."}</p><a href="/games" class="link">Voltar aos jogos</a></PageLayout>}
